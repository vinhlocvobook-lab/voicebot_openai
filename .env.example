# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_WEBHOOK_SECRET=whsec_...    # Lấy từ platform.openai.com > Project > Webhooks
OPENAI_PROJECT_ID=proj_...         # Lấy từ platform.openai.com > Project > General
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# reasoning_effort cho model realtime 2.1.x: minimal|low|medium|high|xhigh.
# "low" là khuyến nghị của OpenAI cho voice agent CSKH (đủ suy luận, ít độ trễ
# cảm nhận được). Xem docs/fix/fix_migrate_gpt_realtime_21_20260730.md.
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_VOICE=alloy                 # alloy | echo | shimmer | ash | ballad | coral | sage | verse

# ── Webhook server ───────────────────────────────────────────
PORT=8000
WEBHOOK_PATH=/webhook              # Path OpenAI POST đến

# ── Asterisk / SIP Transfer ──────────────────────────────────
# SIP URI của hàng đợi tổng đài viên trong Asterisk
# Khi AI cần chuyển máy sẽ dùng URI này
AGENT_QUEUE_URI=sip:200@192.168.1.100   # VD: sip:queue_cskh@asterisk_host

# ── Log ──────────────────────────────────────────────────────
LOG_LEVEL=info    # debug | info | warn | error

# ── REST API Tổng đài (backend dữ liệu thật) ─────────────────
TONGDAI_API_BASE=http://127.0.0.1:7700/api.php
TONGDAI_API_TIMEOUT_MS=15000

# ── REST API ghi log nội bộ (voicebot_calllog/voicebot_toolcall/ticket) ──────
# Thay cho việc Node kết nối thẳng MariaDB (db.js cũ) — nay gọi qua
# cntaapi1/voicebot-log-api.php (repo voice_chat_bot), xem src/log-api.js.
# Bỏ trống LOG_API_BASE để TẮT ghi log qua API (bot vẫn chạy, chỉ lưu file JSON).
LOG_API_BASE=http://127.0.0.1:7700/voicebot-log-api.php
LOG_API_TIMEOUT_MS=15000

# ── [LEGACY — chỉ dùng nếu rollback về db.js] Database (MariaDB/MySQL) ──────
# db.js (kết nối MySQL trực tiếp) vẫn còn trong repo làm bản dự phòng, KHÔNG
# còn được import ở server.js/session-ws.js/conversation-logger.js (đã chuyển
# sang log-api.js ở trên). Giữ các biến này lại phòng khi cần đổi import về
# db.js để rollback nhanh.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=voicebot
DB_PASSWORD=
DB_NAME=voicebot
DB_CONNECTION_LIMIT=5
# DB_ENABLED=false   # đặt false để tắt ghi DB dù đã cấu hình DB_HOST

# Trọng tài mã danh bộ (fix 19/07/2026): 2 lần đọc chưa chốt được → model mạnh
# đối chiếu các bản nghe + transcript để suy ra dãy 11 số khả dĩ nhất.
DANH_BO_ARBITER_MODEL=gpt-5.1
DANH_BO_ARBITER_TIMEOUT_MS=12000
# reasoning_effort: none|low|medium|high — model đang "suy nghĩ" GIỮA cuộc gọi
# thoại (khách chờ trong im lặng), "low" cân bằng tốc độ/độ chính xác cho việc
# đối chiếu vài dãy số nhiễu. Tăng lên "medium" nếu thấy trọng tài suy luận ẩu.
DANH_BO_ARBITER_REASONING_EFFORT=low
# Ngưỡng tin cậy tối thiểu (0.0-1.0) để đọc lại số cho khách xác nhận — dưới
# ngưỡng này thì escalation (chuyển tổng đài viên / tạo phiếu) thay vì đọc bừa.
DANH_BO_ARBITER_MIN_CONFIDENCE=0.7

# [migrate 30/07/2026] locked (mặc định, KHUYẾN NGHỊ) = MỨC C hiện tại:
# create_response:false khoá model trong giai đoạn đọc số, CODE phát mọi câu
# thoại qua _speakVerbatim — cơ chế đã kiểm chứng qua nhiều cuộc gọi thật.
# unlocked (THỬ NGHIỆM, ĐÃ TEST THẬT 30/07 — THẤT BẠI, xem migration doc) = để
# model tự trả lời trong lúc thu số (create_response:true) ở CẢ giai đoạn gom số
# lẫn xác nhận, dựa hoàn toàn vào reasoning + prompt thay vì khoá cứng API-level.
# confirm_tool (THỬ NGHIỆM MỚI, hẹp hơn "unlocked") = giai đoạn GOM SỐ vẫn khoá
# y hệt "locked" (không đổi — đây không phải chỗ xung đột); CHỈ mở khoá ở giai
# đoạn XÁC NHẬN (đã có ứng viên) — model tự đọc câu xác nhận qua tool mới
# `confirm_danh_bo` (ép bằng tool_choice, không phải hy vọng prompt tuân thủ)
# thay vì bị code ép đọc nguyên văn qua _speakVerbatim. Có gate chống model tự
# gọi lặp tool này vô hạn lần (DANH_BO_CONFIRM_SPAM_MAX bên dưới). CHỈ bật sau
# khi tự test bằng cuộc gọi thật — xem docs/fix/fix_migrate_gpt_realtime_21_20260730.md.
DANH_BO_MODE=locked

# [migrate 30/07/2026 — chỉ dùng khi DANH_BO_MODE=confirm_tool] Model tự gọi lại
# confirm_danh_bo bao nhiêu lần LIÊN TIẾP mà không có lượt khách mới xen giữa
# thì coi là kẹt vòng lặp → code tự khoá lại + đọc câu xác nhận một lần bằng cơ
# chế cũ (_speakVerbatim) thay vì để khách nghe lặp lại vô ích.
DANH_BO_CONFIRM_SPAM_MAX=3
