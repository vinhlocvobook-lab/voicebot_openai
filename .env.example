# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_WEBHOOK_SECRET=whsec_...    # Lấy từ platform.openai.com > Project > Webhooks
OPENAI_PROJECT_ID=proj_...         # Lấy từ platform.openai.com > Project > General
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_VOICE=alloy                 # alloy | echo | shimmer | ash | ballad | coral | sage | verse

# ── Webhook server ───────────────────────────────────────────
PORT=8000
WEBHOOK_PATH=/webhook              # Path OpenAI POST đến

# ── Asterisk / SIP Transfer ──────────────────────────────────
# SIP URI của hàng đợi tổng đài viên trong Asterisk
# Khi AI cần chuyển máy sẽ dùng URI này
AGENT_QUEUE_URI=sip:200@192.168.1.100   # VD: sip:queue_cskh@asterisk_host

# ── Log ──────────────────────────────────────────────────────
LOG_LEVEL=info    # debug | info | warn | error

# ── REST API Tổng đài (backend dữ liệu thật) ─────────────────
TONGDAI_API_BASE=http://127.0.0.1:7700/api.php
TONGDAI_API_TIMEOUT_MS=15000

# ── Database (MariaDB/MySQL) — ghi log cuộc gọi vào voicebot_calllog ──
# Bỏ trống DB_HOST để TẮT ghi DB (bot vẫn chạy, chỉ lưu file JSON như cũ).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=voicebot
DB_PASSWORD=
DB_NAME=voicebot
DB_CONNECTION_LIMIT=5
# DB_ENABLED=false   # đặt false để tắt ghi DB dù đã cấu hình DB_HOST

# Trọng tài mã danh bộ (fix 19/07/2026): 2 lần đọc chưa chốt được → model mạnh
# đối chiếu các bản nghe + transcript để suy ra dãy 11 số khả dĩ nhất.
DANH_BO_ARBITER_MODEL=gpt-5.1
DANH_BO_ARBITER_TIMEOUT_MS=12000
# reasoning_effort: none|low|medium|high — model đang "suy nghĩ" GIỮA cuộc gọi
# thoại (khách chờ trong im lặng), "low" cân bằng tốc độ/độ chính xác cho việc
# đối chiếu vài dãy số nhiễu. Tăng lên "medium" nếu thấy trọng tài suy luận ẩu.
DANH_BO_ARBITER_REASONING_EFFORT=low
# Ngưỡng tin cậy tối thiểu (0.0-1.0) để đọc lại số cho khách xác nhận — dưới
# ngưỡng này thì escalation (chuyển tổng đài viên / tạo phiếu) thay vì đọc bừa.
DANH_BO_ARBITER_MIN_CONFIDENCE=0.7
